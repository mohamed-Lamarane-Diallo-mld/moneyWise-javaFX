<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.project.controller.AdminTransactionsController"
      styleClass="home-root"
      stylesheets="@../style/global.css, @../style/sidebar.css,
                   @../style/home.css, @../style/transaction.css"
      maxWidth="Infinity" maxHeight="Infinity">

    <fx:include fx:id="sidebar" source="Sidebar.fxml"/>

    <VBox HBox.hgrow="ALWAYS">

        <!-- HEADER -->
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="0">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Administration des transactions" styleClass="header-title"/>
                <Label fx:id="headerDate" text="" styleClass="header-date"/>
            </VBox>
            <HBox spacing="14" alignment="CENTER">
                <VBox alignment="CENTER" spacing="2"
                      style="-fx-background-color:#EAE8FF;-fx-background-radius:10;-fx-padding:8 18;">
                    <Label text="TRANSACTIONS"
                           style="-fx-font-size:9px;-fx-font-weight:bold;-fx-text-fill:#6C63FF;"/>
                    <Label fx:id="headerTotalTrans" text="— total"
                           style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#4338CA;"/>
                </VBox>
            </HBox>
        </HBox>

        <!-- Ligne décorative -->
        <Region prefHeight="2"
                style="-fx-background-color:linear-gradient(to right,#6C63FF 0%,#2ECC71 50%,transparent 100%);-fx-opacity:0.5;"/>

        <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="scroll-pane">
            <VBox styleClass="home-content" spacing="22">

                <!-- TITRE -->
                <VBox spacing="2">
                    <Label text="Administration des transactions" styleClass="section-title"/>
                    <Label text="Gérer toutes les transactions de l'application" styleClass="section-subtitle"/>
                </VBox>

                <!-- KPI CARDS -->
                <HBox spacing="16">

                    <!-- TOTAL TRANSACTIONS -->
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="0">
                        <HBox alignment="CENTER_LEFT" spacing="0">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="T" styleClass="kpi-badge-green"/>
                                    <Label text="TOTAL TRANSACTIONS" styleClass="kpi-label"/>
                                </HBox>
                                <Label fx:id="kpiTotalTransactions" text="0" styleClass="kpi-value, kpi-value-green"/>
                                <Label text="opérations enregistrées" styleClass="kpi-evolution"/>
                            </VBox>
                            <StackPane styleClass="kpi-icon-box, kpi-icon-box-green">
                                <FontIcon iconLiteral="fas-exchange-alt" styleClass="kpi-icon" iconSize="20"/>
                            </StackPane>
                        </HBox>
                        <Region prefHeight="14"/>
                        <Region styleClass="kpi-bar-green" maxWidth="56"/>
                    </VBox>

                    <!-- TOTAL ENTRÉES -->
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="0">
                        <HBox alignment="CENTER_LEFT" spacing="0">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="E" styleClass="kpi-badge-purple"/>
                                    <Label text="TOTAL ENTRÉES" styleClass="kpi-label"/>
                                </HBox>
                                <Label fx:id="kpiTotalEntrees" text="0 FCFA" styleClass="kpi-value" style="-fx-text-fill:#6C63FF;"/>
                                <Label text="somme des entrées" styleClass="kpi-evolution"/>
                            </VBox>
                            <StackPane styleClass="kpi-icon-box" style="-fx-background-color:#EAE8FF;">
                                <FontIcon iconLiteral="fas-arrow-up" styleClass="kpi-icon-purple" iconSize="20"/>
                            </StackPane>
                        </HBox>
                        <Region prefHeight="14"/>
                        <Region style="-fx-background-color:#6C63FF;-fx-background-radius:2;-fx-pref-height:3;" maxWidth="56"/>
                    </VBox>

                    <!-- TOTAL SORTIES -->
                    <VBox styleClass="kpi-card-purple" HBox.hgrow="ALWAYS" spacing="0">
                        <HBox alignment="CENTER_LEFT" spacing="0">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="S" styleClass="kpi-badge-white"/>
                                    <Label text="TOTAL SORTIES" styleClass="kpi-label-white"/>
                                </HBox>
                                <Label fx:id="kpiTotalSorties" text="0 FCFA" styleClass="kpi-value, kpi-value-white"/>
                                <Label text="somme des sorties" styleClass="kpi-evolution-white"/>
                            </VBox>
                            <StackPane styleClass="kpi-icon-box, kpi-icon-box-purple">
                                <FontIcon iconLiteral="fas-arrow-down" styleClass="kpi-icon-white" iconSize="20"/>
                            </StackPane>
                        </HBox>
                        <Region prefHeight="14"/>
                        <Region styleClass="kpi-bar-white" maxWidth="56"/>
                    </VBox>

                    <!-- MONTANT MOYEN -->
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="0">
                        <HBox alignment="CENTER_LEFT" spacing="0">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="M" styleClass="kpi-badge-red"/>
                                    <Label text="MONTANT MOYEN" styleClass="kpi-label"/>
                                </HBox>
                                <Label fx:id="kpiMontantMoyen" text="0 FCFA" styleClass="kpi-value, kpi-value-red"/>
                                <Label text="par transaction" styleClass="kpi-evolution"/>
                            </VBox>
                            <StackPane styleClass="kpi-icon-box, kpi-icon-box-red">
                                <FontIcon iconLiteral="fas-chart-line" styleClass="kpi-icon-red" iconSize="20"/>
                            </StackPane>
                        </HBox>
                        <Region prefHeight="14"/>
                        <Region styleClass="kpi-bar-red" maxWidth="56"/>
                    </VBox>

                </HBox>

                <!-- FILTRES -->
                <VBox styleClass="table-card" spacing="0">
                    <HBox styleClass="table-header-zone" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-filter" styleClass="filter-icon" iconSize="14"/>
                        <Label text="  Filtrer les transactions" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                        <Button text="✕ Réinitialiser" styleClass="btn-voir-tout"
                                style="-fx-font-size:11px;-fx-padding:5 12;" onAction="#onResetFilters"/>
                    </HBox>
                    <Separator style="-fx-opacity:0.4;"/>
                    <HBox style="-fx-padding:12 18;" spacing="10" alignment="CENTER_LEFT">
                        <HBox alignment="CENTER_LEFT" spacing="0"
                              style="-fx-background-color:#F7FAFC;-fx-border-color:#E2E8F0;-fx-border-radius:8;-fx-background-radius:8;">
                            <FontIcon iconLiteral="fas-search" styleClass="search-icon" iconSize="12"/>
                            <TextField fx:id="searchField" promptText="Rechercher par description..."
                                       style="-fx-background-color:transparent;-fx-border-color:transparent;-fx-padding:7 10 7 5;-fx-font-size:12px;"
                                       prefWidth="200" onKeyReleased="#onSearchChanged"/>
                        </HBox>
                        <ComboBox fx:id="filterType" promptText="Type"
                                  style="-fx-background-color:#F7FAFC;-fx-border-color:#E2E8F0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;"
                                  prefWidth="130" onAction="#onFilterChanged"/>
                        <ComboBox fx:id="filterUtilisateur" promptText="Utilisateur"
                                  style="-fx-background-color:#F7FAFC;-fx-border-color:#E2E8F0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;"
                                  prefWidth="180" onAction="#onFilterChanged"/>
                        <DatePicker fx:id="filterDateDebut" promptText="Date début"
                                    style="-fx-background-color:#F7FAFC;-fx-border-color:#E2E8F0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;"
                                    onAction="#onFilterChanged"/>
                        <DatePicker fx:id="filterDateFin" promptText="Date fin"
                                    style="-fx-background-color:#F7FAFC;-fx-border-color:#E2E8F0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;"
                                    onAction="#onFilterChanged"/>
                    </HBox>
                </VBox>

                <!-- TABLE TRANSACTIONS -->
                <VBox styleClass="table-card" spacing="0">
                    <HBox styleClass="table-header-zone" alignment="CENTER_LEFT">
                        <VBox HBox.hgrow="ALWAYS" spacing="2">
                            <Label text="Liste des transactions" styleClass="section-title"/>
                            <Label fx:id="countLabel" text="0 transaction(s)" styleClass="section-subtitle"/>
                        </VBox>
                    </HBox>
                    <Separator style="-fx-opacity:0.5;"/>

                    <TableView fx:id="transactionsTable"
                               styleClass="table-view"
                               prefHeight="440"
                               VBox.vgrow="ALWAYS"
                               style="-fx-background-color:transparent;
                                      -fx-border-color:transparent;
                                      -fx-table-cell-border-color:transparent;">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colDate"        text="DATE"          minWidth="100" maxWidth="110"/>
                            <TableColumn fx:id="colDescription" text="DESCRIPTION"   minWidth="200"/>
                            <TableColumn fx:id="colCategorie"   text="CATÉGORIE"     minWidth="120" maxWidth="150"/>
                            <TableColumn fx:id="colUtilisateur" text="UTILISATEUR"   minWidth="150" maxWidth="180"/>
                            <TableColumn fx:id="colType"        text="TYPE"          minWidth="80"  maxWidth="90"/>
                            <TableColumn fx:id="colMontant"     text="MONTANT"       minWidth="120" maxWidth="140"/>
                            <TableColumn fx:id="colActions"     text="ACTIONS"       minWidth="100" maxWidth="120"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8" style="-fx-padding:50;">
                                <FontIcon iconLiteral="fas-exchange-alt" iconSize="36" style="-fx-icon-color: #94A3B8;"/>
                                <Label text="Aucune transaction trouvée"
                                       style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#64748B;"/>
                                <Label text="Modifiez les filtres pour afficher des résultats."
                                       style="-fx-font-size:12px;-fx-text-fill:#94A3B8;"/>
                            </VBox>
                        </placeholder>
                    </TableView>

                    <!-- PAGINATION -->
                    <HBox alignment="CENTER" spacing="8"
                          style="-fx-padding:10 18;-fx-background-color:#FAFBFF;
                                 -fx-border-color:#F0F0F0 transparent transparent transparent;">
                        <Label fx:id="paginationInfo" text=""
                               style="-fx-font-size:11px;-fx-text-fill:#718096;" HBox.hgrow="ALWAYS"/>
                        <HBox spacing="5" alignment="CENTER">
                            <Button fx:id="btnPremierePage" text="«" onAction="#goToPremierePage"
                                    styleClass="btn-voir-tout" style="-fx-min-width:32px;-fx-font-weight:bold;"/>
                            <Button fx:id="btnPagePrev" text="‹ Préc." onAction="#goToPagePrecedente" styleClass="btn-voir-tout"/>
                            <HBox fx:id="pageNumbersBox" spacing="4" alignment="CENTER"/>
                            <Button fx:id="btnPageNext" text="Suiv. ›" onAction="#goToPageSuivante" styleClass="btn-voir-tout"/>
                            <Button fx:id="btnDernierePage" text="»" onAction="#goToDernierePage"
                                    styleClass="btn-voir-tout" style="-fx-min-width:32px;-fx-font-weight:bold;"/>
                        </HBox>
                        <HBox spacing="6" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                            <Label text="Par page :" style="-fx-font-size:11px;-fx-text-fill:#718096;"/>
                            <ComboBox fx:id="pageSizeCombo" prefWidth="65" onAction="#onPageSizeChanged"
                                      style="-fx-background-color:#F7FAFC;-fx-border-color:#E2E8F0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;"/>
                        </HBox>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>